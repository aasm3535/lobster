{
  "telegram": {
    "token": "PUT-YOUR-TELEGRAM-BOT-TOKEN-HERE"
  },
  "models": [
    {
      "name": "gpt",
      "type": "openai",
      "base_url": "https://api.openai.com/v1",
      "api_key": "${OPENAI_API_KEY}",
      "model": "gpt-4o-mini"
    },
    {
      "name": "claude",
      "type": "anthropic",
      "base_url": "https://api.anthropic.com",
      "api_key": "${ANTHROPIC_API_KEY}",
      "model": "claude-3-5-sonnet-latest"
    }
  ],
  "auth": {
    "open": false,
    "allowed_chats": [],
    "access_code": ""
  },
  "mcp": {
    "servers": [
      {
        "name": "filesystem",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-filesystem", "C:\\Users\\you\\projects"],
        "env": { "EXAMPLE_TOKEN": "${EXAMPLE_TOKEN}" },
        "disabled": true
      }
    ]
  },
  "system": "",
  "verbosity": "normal",
  "streaming": "on",
  "max_steps": -1
}
