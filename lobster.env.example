# Lobster secrets. Copy to ~/.lobster/.env (do NOT commit the real one).
#
# These are loaded into the environment at startup:
#   - reference any of them from lobster.json as ${NAME}
#   - MCP server subprocesses inherit them automatically (many read their key from env)
# A real environment variable already set takes precedence over this file.

# Provider key (reference it in lobster.json: "api_key": "${LOBSTER_API_KEY}")
LOBSTER_API_KEY=sk-...

# Telegram bot token (or keep it in lobster.json)
# LOBSTER_TELEGRAM_TOKEN=123456:ABC...

# MCP server tokens — e.g. the Exa search server reads EXA_API_KEY from its env,
# so just put it here and you don't even need to list it in the config's "env".
# EXA_API_KEY=...
# GITHUB_PERSONAL_ACCESS_TOKEN=...
